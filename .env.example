# Forge environment — copy to .env and fill in. Validated at boot (@forge/config);
# a missing or malformed value fails fast with a named error rather than booting
# half-configured. Secrets live here only in local dev; in deployment they come
# from the platform's secret store, never from a committed file.

# One of: development | test | production
NODE_ENV=development

# Postgres connection string (the docker-compose dev DB runs on port 5434).
# This is the OWNER connection (migrations, system tasks).
DATABASE_URL=postgres://forge:forge@localhost:5434/forge

# The non-owner app-role connection — RLS applies to this one. The app uses it for
# all tenant data access; migrations use DATABASE_URL above.
FORGE_APP_DATABASE_URL=postgres://forge_app:forge_app@localhost:5434/forge

# Public base URL of the app. Must not be localhost in production.
APP_URL=http://localhost:3000

# One of: debug | info | warn | error
LOG_LEVEL=info
