{
  "name": "forge",
  "version": "0.0.0",
  "private": true,
  "description": "A production-grade, reusable, AI-native full-stack foundation for building AI SaaS apps.",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test:arch": "vitest run architecture.test.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
